# Everything here is optional. Copy this file to .env for local use,
# or add the same names as variables in your hosting dashboard.

# Where the database lives (point this at a persistent disk when hosting).
DATA_DIR=./data

# A contact address Apple/Google can reach you at about push notifications.
VAPID_SUBJECT=mailto:you@example.com

# The public address of the app (used in invite emails).
APP_URL=https://your-app.up.railway.app

# Email (optional): lets TaskFlow email share invites and, if a user turns it on, reminders.
# For Gmail, create a NEW app password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
