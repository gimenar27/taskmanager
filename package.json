{
  "name": "taskflow",
  "version": "2.0.0",
  "description": "TaskFlow: a phone-friendly task and reminder app with push notifications, repeating bill reminders and sharing.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "cf:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "icons": "python3 scripts/make_icons.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "author": "Gimena Rios Moreno",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  }
}
